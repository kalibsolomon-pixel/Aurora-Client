{
  "schemaVersion": 1,
  "id": "aurora",
  "version": "${version}",
  "name": "Aurora Client",
  "icon": "assets/aurora/icon.png",
  "description": "A lightweight Fabric client with QoL features, zoom, full bright, and a custom title screen.",
  "authors": [
    "Kalib"
  ],
  "contact": {
    "homepage": "https://example.com",
    "sources": "https://example.com"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.aurora.client.AuroraClient"
    ]
  },
  "mixins": [
    "aurora.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "breaks": {
    "betterhitreg": "*"
  }
}
